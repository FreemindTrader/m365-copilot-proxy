{
  "name": "@m365-copilot/proxy",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "m365-proxy": "./dist/server.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.mts"
    }
  },
  "main": "./dist/server.mjs",
  "types": "./dist/server.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsdown src/server.ts --format esm --dts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@m365-copilot/core": "workspace:*",
    "@m365-copilot/proxy-lib": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
