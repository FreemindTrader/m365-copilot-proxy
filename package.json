{
  "name": "opencode-m365",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @opencode-m365/proxy dev",
    "build": "pnpm -r build",
    "proxy": "node packages/proxy/dist/server.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && npx vitest run",
    "test:live": "pnpm build && M365_LIVE=1 npx vitest run"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
